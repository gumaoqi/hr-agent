# 复制为 .env 并填写真实值。API Key 与 aiMate 项目 local.properties 中 DEEPSEEK_API_KEY 保持一致
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-flash
PORT=3000

# 讯飞录音文件转写大模型（功能4 面试评分使用；未配置时可用转录文本兜底）
# 三件套：AppID / APIKey / APISecret（讯飞控制台-应用「服务接口认证信息」获取）
XF_APP_ID=
XF_API_KEY=
XF_APISECRET=

# Supabase（Netlify 部署时需要：简历缓存表 + 录音 Storage + 转写任务表；本地自托管可不配，回退内存缓存）
# 在 Supabase 控制台 Project Settings → API 获取
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

